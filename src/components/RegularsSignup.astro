---
// "Grab our Newsletter / Become a Regular here!" block (used on several pages).
// TODO: connect the form to ActiveCampaign (it doesn't send yet).
interface Props {
	heading?: string;
	perks?: string[];
	buttonLabel?: string;
	sectionBg?: string;
	boxBg?: string;
	boxHeading?: string;
}
const {
	heading = 'Grab our NEWSLETTER!',
	perks = [
		'Follow the progress of our each of our projects and programs.',
		'Be alerted to all <strong>updates</strong> and <strong>new resources.</strong>',
		'The newsletter is sent to your email address <strong>once a month</strong> (more or less predictably!)',
	],
	buttonLabel = 'Sign Up',
	sectionBg = '#ffecc5',
	boxBg = '#707070',
	boxHeading = '',
} = Astro.props;
---

<section class="px-4 py-14" style={`background: ${sectionBg}`}>
	<div class="mx-auto grid max-w-[856px] items-center gap-8 md:grid-cols-[453px_381px] md:gap-[22px]">
		<div class="text-[16px] leading-[1.4]">
			{heading && <p class="mb-5 text-center text-[24px] font-bold">{heading}</p>}
			<ul class="space-y-3">
				{
					perks.map((p) => (
						<li class="flex items-start gap-3">
							<svg viewBox="0 0 512 512" class="mt-0.5 size-[30px] shrink-0 fill-[#ffc000]" aria-hidden="true"><path d="M504 256c0 136.967-111.033 248-248 248S8 392.967 8 256 119.033 8 256 8s248 111.033 248 248zM227.314 387.314l184-184c6.248-6.248 6.248-16.379 0-22.627l-22.627-22.627c-6.248-6.249-16.379-6.249-22.628 0L216 308.118l-70.059-70.059c-6.248-6.248-16.379-6.248-22.628 0l-22.627 22.627c-6.248 6.248-6.248 16.379 0 22.627l104 104c6.249 6.249 16.379 6.249 22.628.001z" /></svg>
							<span set:html={p} />
						</li>
					))
				}
			</ul>
		</div>
		<div class="px-[21px] pt-10 pb-6 text-center text-white" style={`background: ${boxBg}`}>
			{boxHeading ? <h3 class="text-[27px] leading-[1.4] font-bold">{boxHeading}</h3> : <h3 class="text-[27px] leading-[1.4] font-bold">Become a <span class="text-[#ffd75c]">Regular</span> here!</h3>}
			<p class="mt-1 text-[18px]">100% Free. Leave anytime.</p>
			<form class="mt-6 space-y-[10px]" action="#" method="post">
				<input type="text" name="name" placeholder="Your Name" aria-label="Your Name" class="h-[56px] w-full bg-[#f8f8f8] px-4 font-button text-[14px] text-black/75" />
				<input type="email" name="email" placeholder="Your Best Email Address" aria-label="Your Best Email Address" required class="h-[56px] w-full bg-[#f8f8f8] px-4 font-button text-[14px] text-black/75" />
				<button type="submit" class="!mt-[19px] flex h-[54px] w-full items-center justify-center gap-2 bg-[#2f8ae5] text-[13px] font-bold tracking-[3px] text-white uppercase transition-opacity hover:opacity-85" style="font-family: Roboto, Arial, sans-serif">
					<svg viewBox="0 0 24 24" class="size-4 fill-white" aria-hidden="true"><path d="M21.65 11.65l-2.79-2.79c-.32-.32-.86-.1-.86.35V11H4c-.55 0-1 .45-1 1s.45 1 1 1h14v1.79c0 .45.54.67.85.35l2.79-2.79c.2-.19.2-.51.01-.7z" /></svg>
					{buttonLabel}
				</button>
			</form>
			<p class="mt-5 mb-0 text-[13px] leading-[1.6]">
				Want spam in your inbox? Sorry, you won’t find it here! We detest spam and we keep your email private.<br />
				See our <a href="/privacy/" class="font-bold text-[#ffd75c]">Privacy Policy</a> for more info.
			</p>
		</div>
	</div>
</section>
