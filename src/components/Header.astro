---
import { topNav, moreNav } from '../data/site';
const main = topNav.filter((l) => l.label !== 'DONATE');
const donate = topNav.find((l) => l.label === 'DONATE');
---

<header class="bg-black text-white">
	<div class="mx-auto flex max-w-[1080px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 lg:py-5">
		<a href="/" class="flex items-center gap-3" aria-label="CLAMcentral home">
			<img src="/images/logo.png" alt="" width="52" height="52" class="size-[44px] lg:size-[52px]" />
			<span class="text-[26px] leading-none font-bold text-lime lg:text-[31px]">CLAMcentral</span>
		</a>
		<nav class="flex flex-wrap items-center gap-x-6 gap-y-1 font-nav text-[17px] font-semibold lg:gap-x-[30px] lg:text-[22px]">
			{main.map((l) => <a href={l.href} class="py-1 hover:text-lime">{l.label}</a>)}
			<div class="group relative" id="more-menu">
				<button type="button" class="cursor-pointer py-1 font-semibold uppercase hover:text-lime" aria-haspopup="true" aria-expanded="false">MORE</button>
				<ul class="absolute top-full left-1/2 z-50 hidden w-[140px] -translate-x-1/2 rounded-[3px] bg-white py-1 text-center font-button text-[16px] font-normal group-hover:block group-focus-within:block group-[.open]:block" style="box-shadow: rgba(0,0,0,.15) 0 0 9px 1px">
					{moreNav.map((l) => <li><a href={l.href} class="block px-3 py-[9px] leading-[22px] font-normal text-[rgb(5,5,61)] hover:bg-black/5">{l.label}</a></li>)}
				</ul>
			</div>
			{donate && <a href={donate.href} class="py-1 hover:text-lime">{donate.label}</a>}
		</nav>
	</div>
</header>
<script is:inline>
(() => {
	const m = document.getElementById('more-menu');
	if (!m) return;
	const b = m.querySelector('button');
	b.addEventListener('click', (e) => { e.stopPropagation(); const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
	document.addEventListener('click', (e) => { if (!m.contains(e.target)) { m.classList.remove('open'); b.setAttribute('aria-expanded', 'false'); } });
})();
</script>
