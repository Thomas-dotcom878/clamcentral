---
// The site's standard button: Arial, bold, spaced-out letters, rounded corners.
interface Props {
	href: string;
	color?: 'teal' | 'charcoal';
	class?: string;
}
const { href, color = 'teal', class: extra = '' } = Astro.props;
const bg = color === 'teal' ? 'bg-teal' : 'bg-charcoal';
---

<a
	href={href}
	class:list={[
		'inline-flex items-center justify-center rounded-[5px] px-[18px] py-[13px] font-button text-[19px] font-bold tracking-[2px] text-white transition-opacity hover:opacity-85 lg:text-[23px]',
		bg,
		extra,
	]}
><slot /></a>
