---
import { footerLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-footer">
	<div class="mx-auto max-w-[1080px] px-4 pt-10 pb-8 text-center">
		<nav class="mx-auto flex max-w-[1000px] flex-wrap justify-center gap-x-[30px] gap-y-2 font-button text-[16px] leading-7 text-black/85">
			{footerLinks.map((l) => <a href={l.href} class="hover:underline">{l.label}</a>)}
		</nav>
		<p class="mt-6 mb-0 text-[13px] text-[#83868b]">Copyright (c) {year} CLAMcentral Ministries. All rights reserved.</p>
	</div>
</footer>
