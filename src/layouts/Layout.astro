---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'CLAMcentral',
	description = 'Free Children’s Ministry resources: Bible Learning Activities, object lessons and Sunday School curriculum.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Boldonse&family=Open+Sans:wght@600&family=Poppins:ital,wght@0,400;0,600;0,700;1,400&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body class="bg-white font-sans text-black antialiased">
		<Header />
		<slot />
		<Footer />
	</body>
</html>
