---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { topicIndex } from '../data/topics';
---

<Layout title="Bible Packs List of Topics - clamcentral.com">
	<main class="bg-page px-4 pt-12 pb-20 lg:px-0">
		<div class="mx-auto max-w-[1246px] text-center">
			<h1 class="text-[36px] leading-[1.3] font-bold text-ink lg:text-[50px]">BLA Packs - List of Topics</h1>
			<p class="mt-2 mb-1 text-[20px] leading-[1.4] lg:text-[22px]">Future updates will be added to this list and pointed out in our monthly Newsletter.</p>
			<p class="text-[20px] leading-[1.4] lg:text-[22px]"><strong>The Meaningful Motions Pack is not listed</strong> because its contents can be used with any topic.</p>
			<Button href="/bible-learning-activities/" color="charcoal" class="mt-3 w-full max-w-[591px] text-[18px] lg:text-[18px]">Go to the BLA Pack download page instead</Button>
		</div>

		<div class="mx-auto mt-12 grid max-w-[1156px] gap-x-[17px] gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
			{
				topicIndex.map((L) => (
					<section class="text-[16px] leading-[1.4]">
						<h2 class="text-[48px] leading-[1.4] font-bold">{L.letter}</h2>
						{L.topics.map((t) => (
							<div class="mb-2">
								<h3 class="text-[20px] leading-[1.4] font-bold">{t.name}</h3>
								{t.items.map(([pack, text]) => (
									<p class:list={['mb-0', !pack && text.startsWith('See ') && 'font-bold']}>
										{pack && <strong>{pack}</strong>} {text}
									</p>
								))}
							</div>
						))}
					</section>
				))
			}
		</div>
	</main>
</Layout>
