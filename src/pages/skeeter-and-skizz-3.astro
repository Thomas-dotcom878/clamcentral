---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Skeeter and Skizz - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/clamcentral-logo.webp" alt="" width="600" height="121" loading="lazy" class="mx-auto h-auto w-full" style="max-width:266px" />
			</div>
			<div style="margin-top:21px">
				<h1 style="font-size:clamp(35px, 3.64vw, 51px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700">Skeeter and Skizz Sack Puppets!</h1>
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>A fun way to teach the little ones :)</strong></p>
			</div>
			<div style="margin-top:25px">
				<img src="/images/pages/skeeter-and-skizz1.webp" alt="" width="2000" height="574" loading="lazy" class="mx-auto h-auto w-full" style="max-width:1000px" />
			</div>
			<div style="margin-top:28px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.60;color:rgb(0, 0, 0);text-align:center">These two adorable dogs have fun telling Sunday School Bible stories as only dogs can. These sack puppies--er, <em>puppets</em> are much easier to use than real dogs, we are quite sure.</p>
			</div>
			<div style="margin-top:1px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.60;color:rgb(0, 0, 0);text-align:center">Fifty stories from our Old Testament curriculum, New Testament is on the way.</p>
			</div>
			<div style="margin-top:2px">
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><a href="/skeeter-and-skizz/Skeeter and Skizz OT.zip"><strong>SKEETER AND SKIZZ</strong></a></p>
			</div>
		</div>
	</main>
</Layout>
