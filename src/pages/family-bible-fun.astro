---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Family Bible Fun - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/clamcentral-logo.webp" alt="" width="600" height="121" loading="lazy" class="mx-auto h-auto w-full" style="max-width:266px" />
			</div>
			<div style="margin-top:21px">
				<h1 style="font-size:clamp(35px, 3.64vw, 51px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700">Family Bible Fun</h1>
			</div>
			<div style="margin-top:2px">
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>Take your Sunday morning teaching into the home.</strong></p>
			</div>
			<div style="margin-top:21px">
				<img src="/images/pages/family-bible-fun2.webp" alt="" width="2080" height="964" loading="lazy" class="mx-auto h-auto w-full" style="max-width:1040px" />
			</div>
			<div style="margin-top:21px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>Family Bible Fun</strong> is inspired by the worldwide lockdowns of a few years ago: Families needed Bible materials to keep their kids growing in the Lord while waiting for the churches to open again. 108 pages. <strong>Thirty solid and fun lessons and activities for the family to do together.</strong></p>
			</div>
			<div>
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><a href="/fbfun/family-bible-fun.pdf"><strong>Click Here to Download</strong> </a></p>
			</div>
		</div>
	</main>
</Layout>
