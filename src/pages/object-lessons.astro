---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Object Lessons - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div class="relative left-1/2 -mt-12 mb-8 w-screen -translate-x-1/2 px-4 py-10" style="background:rgb(65, 84, 60)">
				<div class="mx-auto max-w-[1080px]">
					<div>
						<img src="/images/pages/object-lessons-banner-5.webp" alt="" width="1602" height="403" loading="lazy" class="mx-auto h-auto w-full" style="max-width:852px" />
					</div>
				</div>
			</div>
			<div>
				<h1 style="font-size:clamp(29px, 3.00vw, 42px);line-height:1.30;color:rgb(51, 51, 51);text-align:center"><strong>Object Lessons with Activity Pages</strong></h1>
			</div>
			<div style="margin-top:18px">
				<p style="font-size:18px;line-height:1.40;color:rgb(70, 70, 70);text-align:left">We have a special YouTube channel that we've named <strong>"The Object Lessons Channel."</strong> How's that for an original title! We post object lesson videos as often as possible. These are not videos you show in class; they show YOU how to do simple yet profound and fun object lessons with your group.</p>
			</div>
			<div>
				<p style="font-size:18px;line-height:1.40;color:rgb(70, 70, 70);text-align:left">Here's the cool thing: <strong>Almost all videos feature a 100% free lesson plan with a Bible learning activity: </strong></p>
			</div>
			<div style="margin-top:21px">
				<img src="/images/pages/lessonplan-2.webp" alt="" width="848" height="607" loading="lazy" class="mx-auto h-auto w-full" style="max-width:460px" />
			</div>
			<div style="margin-top:21px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center"><strong>You can even sign up to receive the video and lesson plan links in your inbox</strong> each time we post a new object lesson. Click the button to learn more:</p>
			</div>
			<div style="margin-top:46px">
				<div class="text-center"><a href="/links" class="inline-block w-full rounded-[5px] px-[18px] py-3 font-button text-[18px] font-bold tracking-[2px] text-white hover:opacity-85" style="max-width:570px;background:rgb(255, 150, 41)">Click to see all the links to lesson plans...</a></div>
			</div>
			<div style="margin-top:25px">
				<p style="font-size:18px;line-height:1.40;color:rgb(70, 70, 70);text-align:left">The latest videos are right here. <strong>Be sure to comment, subscribe and hit the like button!</strong></p>
			</div>
		</div>
	</main>
</Layout>
