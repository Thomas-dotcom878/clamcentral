---
// Thank-you page after the Object Lesson links sign-up on /links/ (ActiveCampaign form 9 redirects here).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Weekly Links Confirmation - clamcentral.com">
	<main class="px-4 pt-12 pb-20">
		<div class="mx-auto max-w-[965px] text-center" style="color:rgb(70, 70, 70)">
			<h1 style="font-size:clamp(28px, 2.86vw, 40px);line-height:1.30;color:rgb(51, 51, 51)"><strong>Right! You've signed up to receive links to our latest Object Lessons.</strong></h1>
			<img src="/wp-content/uploads/2021/08/10minballoon.png" alt="" width="300" class="mx-auto mt-10 mb-12 h-auto w-full" style="max-width:300px" />
			<p style="font-size:18px;line-height:1.40">Each time we post a new video at The Object Lessons Channel you'll receive the video link and any downloadable resource link just moments after the video goes live on YouTube, so you'll have it fresh from the oven!</p>
			<p style="font-size:18px;line-height:1.40">Thanks so much for your interest, and be sure to explore our CLAMcentral site right now!</p>
		</div>
	</main>
</Layout>
