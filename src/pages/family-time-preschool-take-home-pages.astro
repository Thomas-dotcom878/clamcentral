---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Family Time Preschool Take Home Pages - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/clamcentral-logo.webp" alt="" width="600" height="121" loading="lazy" class="mx-auto h-auto w-full" style="max-width:266px" />
			</div>
			<div style="margin-top:21px">
				<h1 style="font-size:clamp(35px, 3.64vw, 51px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700">Family Time Preschool Pages</h1>
			</div>
			<div style="margin-top:2px">
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>Take your Sunday morning teaching into the home.</strong></p>
			</div>
			<div style="margin-top:21px">
				<img src="/images/pages/family-time1.webp" alt="" width="2080" height="591" loading="lazy" class="mx-auto h-auto w-full" style="max-width:1040px" />
			</div>
			<div style="margin-top:22px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center"><strong>Family Time Preschool Take Home Pages:</strong> One Hundred Bible Stories starting with the Old Testament , finishing with the New. Based on our CLAMbake Old and New Testament Sunday School curriculum. The CLAMbake lessons already come with these but here they are separated and included so that you can use them with your favorite curriculum.</p>
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center">Looking at the image above, you can see that Family Time Take-Homes have a kid-level Bible story for Mom or Dad to read to the little ones. On that same side of the page is a cartoon character that demonstrates how to teach your child simple sign language spelling out short thoughts about God. On the reverse is a coloring page.</p>
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center"><strong>Please Note:</strong> Each PDF file features five take-homes, about a month's worth. None of the filenames identify the Bible topic...five stories in one would make a very long filename! But they are in biblical order, so you should be able to find the one you want fairly quickly.</p>
			</div>
			<div>
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><a href="/family-time/Family Time Take Home Papers.zip"><strong>Click Here to Download</strong> </a></p>
			</div>
		</div>
	</main>
</Layout>
