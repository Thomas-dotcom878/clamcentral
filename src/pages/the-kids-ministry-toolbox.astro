---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
import AcFields from '../components/AcFields.astro';
import { activeCampaign } from '../data/site';
---

<Layout title="The Kids Ministry Toolbox - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/clamcentral-logo.webp" alt="" width="600" height="121" loading="lazy" class="mx-auto h-auto w-full" style="max-width:300px" />
			</div>
			<div style="margin-top:64px">
				<img src="/images/pages/toolboxcover.webp" alt="" width="694" height="784" loading="lazy" class="mx-auto h-auto w-full" style="max-width:406px" />
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center">100% Free <strong>Kids Ministry Toolbo</strong><strong>x</strong> Download</p>
			</div>
			<div style="margin-top:23px">
				<h1 style="font-size:clamp(27px, 2.86vw, 40px);line-height:1.30;color:rgb(109, 184, 255);text-align:center;font-weight:700">Covering the key issues that challenge</h1>
			</div>
			<div>
				<h1 style="font-size:clamp(27px, 2.86vw, 40px);line-height:1.30;color:rgb(38, 79, 111);text-align:center;font-weight:700">Children's Ministry and Sunday School leaders.</h1>
			</div>
			<div style="margin-top:48px">
				<img src="/images/pages/toolbox-pages.webp" alt="" width="2080" height="438" loading="lazy" class="mx-auto h-auto w-full" style="max-width:1040px" />
			</div>
			<div style="margin-top:31px">
				<h3 style="font-size:clamp(19px, 2.00vw, 28px);line-height:1.40;color:rgb(12, 17, 21);text-align:center;font-weight:700">You'll learn:</h3>
			</div>
			<div style="margin-top:1px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.65;color:rgb(0, 0, 0);text-align:left;max-width:473px;margin-left:auto;margin-right:auto">• The TRUE vision for your Children's Ministry.</p>
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.65;color:rgb(0, 0, 0);text-align:left;max-width:473px;margin-left:auto;margin-right:auto">• Our Lord’s Treasure Map to Lifelong Discipleship</p>
			</div>
			<div style="margin-top:1px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.65;color:rgb(0, 0, 0);text-align:left;max-width:473px;margin-left:auto;margin-right:auto">• The Why's and How's of Building Your Base<br />• Many of the Best Sunday School Ideas<br />• Many of the The Best Kids Ministry Tips and Ideas</p>
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.64vw, 23px);line-height:1.65;color:rgb(0, 0, 0);text-align:left;max-width:473px;margin-left:auto;margin-right:auto">• Forty+ pages of wisdom!</p>
			</div>
			<div style="margin-top:31px">
				<form class="mx-auto space-y-[12px]" style="max-width:526px" action={activeCampaign.action} method="post"><AcFields form="toolbox" /><input type="text" name="fullname" placeholder="Your Name" aria-label="Your Name" class="h-[51px] w-full rounded-[3px] border border-[#ccc] bg-white px-4 font-button text-[14px]" /><input type="email" name="email" placeholder="Your best email" aria-label="Your best email" required class="h-[51px] w-full rounded-[3px] border border-[#ccc] bg-white px-4 font-button text-[14px]" /><button type="submit" class="h-[54px] w-full font-bold text-white hover:opacity-85" style="font-family: Roboto, Arial, sans-serif;font-size:20px;letter-spacing:1px;background:rgb(38, 79, 111)">GET IT NOW</button></form>
			</div>
			<div style="margin-top:21px">
				<p style="font-size:16px;line-height:1.40;color:rgb(0, 0, 0);text-align:center;max-width:526px;margin-left:auto;margin-right:auto">Want spam in your inbox? Sorry, you won't find it here! We detest spam and we keep your email private.</p>
			</div>
			<div>
				<p style="font-size:16px;line-height:1.40;color:rgb(0, 0, 0);text-align:center;max-width:526px;margin-left:auto;margin-right:auto">See our <a href="/privacy">Privacy Policy</a> for more info.</p>
			</div>
		</div>
	</main>
</Layout>
