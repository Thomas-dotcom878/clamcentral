			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/Meaning-and-Purpose.pdf">Meaning and Purpose</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/Faith_in_Action.pdf">Faith in Action</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/teach-the-Lords-Prayer.pdf">Teach the Lord's Prayer</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/Not-Fair.pdf">Life's Not Fair</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/teach-kids-to-serve.pdf">Teach Kids to Serve (Why Go to Church)</a></p>
