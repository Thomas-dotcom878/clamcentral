---
// Generated from the live WordPress page, then tidied by hand where needed.
import Layout from '../layouts/Layout.astro';
import AcFields from '../components/AcFields.astro';
import { activeCampaign } from '../data/site';
---

<Layout title="Links - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffcf4">
		<div class="mx-auto max-w-[745px]">
			<h1 style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700;margin-bottom:24px">Object Lesson Plans Download Links</h1>
			<h3 style="font-size:18px;line-height:1.40;color:rgb(12, 17, 21);text-align:center;font-weight:700;margin-bottom:16px">But First...Would You Like to Receive the Links Automatically Each Week?</h3>
			<div class="flex flex-col items-center gap-4 sm:flex-row sm:items-start">
				<img src="/images/object-lessons-cover.webp" alt="iPhone Object Lessons" width="226" height="277" class="w-[171px] shrink-0" />
				<div class="pt-6"><p style="font-size:16px;line-height:1.40;color:rgb(0, 0, 0);text-align:center">Each time we post a new video at <strong>The Object Lessons Channel</strong> you'll get an email with a link to the video and, if there is a PDF resource available for that video, a link to that as well. When you fill out and submit the form we will immediately send you a confirmation email.</p><p style="font-size:16px;line-height:1.40;color:rgb(0, 0, 0);text-align:center">The email has a link to download the <strong>free iPhone Object Lessons PDF file.</strong> No other emails will be sent to you, and no marketing offers either. Unsubscribe anytime.</p></div>
			</div>
			<form class="mx-auto mt-8 max-w-[635px] space-y-[10px] bg-[#fff3d5] px-10 py-8" action={activeCampaign.action} method="post"><AcFields form="links" />
				<input type="text" name="fullname" placeholder="Your Name" aria-label="Your Name" class="h-[56px] w-full border border-[#ddd] bg-white px-4 font-button text-[14px]" />
				<input type="email" name="email" placeholder="Your Email" aria-label="Your Email" required class="h-[56px] w-full border border-[#ddd] bg-white px-4 font-button text-[14px]" />
				<button type="submit" class="!mt-[19px] h-[56px] w-full bg-[#ff9531] font-button text-[24px] font-bold text-white hover:opacity-85">SIGN ME UP!</button>
			</form>
			<h2 style="font-size:clamp(19px, 2.00vw, 28px);line-height:1.40;color:rgb(12, 17, 21);text-align:left;font-weight:700;margin-top:48px;margin-bottom:8px">The Links...</h2>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><strong>PDF Files</strong></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/icebreakers/Comic-Strip-Icebreaker.pdf">Comic Strip Icebreaker</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/icebreakers/nine-icebreakers.pdf">Nine Icebreakers</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/the-trinity.pdf">The Trinity</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/God_Likes_Me.pdf">Does God Like Me?</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/gimme-a-minute.pdf">Gimme a Minute</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/name-game.pdf">What's in a Name</a></p>
