			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/Right-and-Wrong.pdf">Understanding Right from Wrong</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/teamwork.pdf">Teamwork</a></p>
			<p style="font-size:18px;line-height:1.40;color:rgb(0, 0, 0);text-align:left;margin-bottom:0"><a href="/objectlessons/The-Will-of-God.pdf"><strong>God's Will 101</strong></a></p>
