---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
import RegularsSignup from '../components/RegularsSignup.astro';
---

<Layout title="Sunday School Newsletter - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/pages/ssi-logo2.webp" alt="" width="704" height="142" loading="lazy" class="mx-auto h-auto w-full" style="max-width:352px" />
			</div>
			<div style="margin-top:21px">
				<h1 style="font-size:clamp(35px, 3.64vw, 51px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700">Sunday School Ideas!</h1>
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.60;color:rgb(0, 0, 0);text-align:center">100% Free <strong>Bible Learning Activities</strong> in Your Inbox</p>
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>Educational Bible Games of all sorts, Coloring Pages, Crafts and more, each matched with a classic Bible Story</strong></p>
			</div>
			<div style="margin-top:50px">
				<RegularsSignup heading="" boxHeading="Sunday School Ideas!" buttonLabel="GET IDEAS" boxBg="#264f6f" sectionBg="transparent" perks={["Receive<strong> three Bible learning activities a week</strong> for about 80 weeks.", "<strong>Three different age-levels: </strong>Pre-K, Younger Elementary and Older Elementary. Every week.", "<strong>Through the Bible</strong> via the classic stories kids love.", "<strong>Fits perfectly into your existing curriculum</strong>. A great way to add spice to your Sunday classes!", "All print to <strong>letter-size paper.</strong>", "You will receive one email a week, each with a link to that week's three activities. <strong>No spam will be sent!</strong>"]} />
			</div>
			<div style="margin-top:45px">
				<img src="/images/pages/13-intro-email-image.webp" alt="" width="1716" height="927" loading="lazy" class="mx-auto h-auto w-full" style="max-width:858px" />
			</div>
			<div style="margin-top:21px">
				<p style="font-size:clamp(18px, 1.79vw, 25px);line-height:1.40;color:rgb(0, 0, 0);text-align:center;max-width:838px;margin-left:auto;margin-right:auto"><strong>Each week you'll receive a quick newsletter with a link to a folder containing four files: The Sunday School guide that has the topic/Bible story (three age-level versions of the same topic/story) and three files of learning activities as shown above.</strong></p>
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.79vw, 25px);line-height:1.40;color:rgb(0, 0, 0);text-align:center;max-width:838px;margin-left:auto;margin-right:auto"><strong>Thanks for serving God by working with kids! - Tom Finley</strong></p>
			</div>
		</div>
	</main>
</Layout>
