---
// Thank-you page after the Kids Ministry Toolbox sign-up (ActiveCampaign form 7 redirects here).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Toolbox Confirmation - clamcentral.com">
	<main class="px-4 pt-12 pb-20">
		<div class="mx-auto max-w-[965px] text-center" style="color:rgb(70, 70, 70)">
			<h1 style="font-size:clamp(34px, 3.57vw, 50px);line-height:1.30;color:rgb(51, 51, 51)"><strong>Your Kids Ministry Toolbox<br />is on its way!</strong></h1>
			<img src="/wp-content/uploads/2019/12/emailletter20.png" alt="" width="301" class="mx-auto mt-10 mb-12 h-auto w-full" style="max-width:301px" />
			<p style="font-size:22px;line-height:1.40"><strong>Check your email.</strong></p>
			<p style="font-size:18px;line-height:1.40">Our goal is to help you disciple kids, helping them celebrate the love and majesty of our Lord. His love is all He says and does, and His majesty is Who He is, the Son of God! God bless you as you serve Him by working with kids.</p>
		</div>
	</main>
</Layout>
