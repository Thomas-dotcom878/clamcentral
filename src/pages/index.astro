---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { donateUrl } from '../data/site';

const downloadPage = '/bible-learning-activities/';

const endorsements = [
	{
		quote: 'What’s happening here is just a joy to see. It’s fun, it’s creative, it’s new and I want you to check it out.',
		name: 'GARY DIXON',
		title: 'Emeritus Director of NWMinCon, Senior Consultant David C Cook',
	},
	{
		quote: 'Tom is one of the most creative people I know. One of my friends once said, “The essence of creativity is the ability to copy.” You get to not only copy but you get to use this incredible stuff wherever you’re doing ministry.',
		name: 'JIM BURNS',
		title: 'President, HomeWord',
	},
	{
		quote: 'If it wasn’t for Tom I wouldn’t be where I am today. And I really love the work that he’s done, I’ve seen what he’s done over the years. I highly recommend anyone to take advantage of the service that he’s prepared to offer.',
		name: 'DR. HUGH ROSS, Ph.D.',
		title: 'Founder and Senior Scholar, Reasons to Believe',
	},
];

const star = 'M46.976,57.227c-0.422,0-0.834-0.104-1.228-0.312l-13.167-6.921c-0.663-0.349-1.409-0.533-2.158-0.533s-1.495,0.185-2.158,0.533L15.1,56.915c-0.393,0.208-0.807,0.312-1.229,0.312c-0.765,0-1.524-0.358-2.03-0.958c-0.501-0.595-0.703-1.346-0.567-2.114l2.514-14.662c0.271-1.578-0.25-3.187-1.396-4.304L1.744,24.807c-0.723-0.705-0.973-1.715-0.661-2.675s1.11-1.636,2.108-1.781l14.719-2.139c1.586-0.23,2.954-1.225,3.661-2.661l6.583-13.338C28.6,1.317,29.481,0.773,30.475,0.773s1.876,0.544,2.322,1.452l6.583,13.338c0.707,1.437,2.076,2.431,3.661,2.661l14.719,2.139c0.998,0.145,1.796,0.82,2.108,1.781s0.062,1.97-0.661,2.675L48.555,35.188c-1.146,1.117-1.668,2.726-1.396,4.304l2.514,14.662c0.136,0.769-0.066,1.52-0.567,2.114C48.5,56.869,47.741,57.227,46.976,57.227z';
---

<Layout title="Home - clamcentral.com">
	<main class="bg-page pb-16">
		<div class="mx-auto max-w-[1080px] px-4 lg:px-0">
			<!-- ===== Hero ===== -->
			<p class="mb-0 pt-7 text-center text-[26px] leading-[1.4] lg:pl-[21px] lg:text-left lg:text-[34px]">
				Your existing curriculum, reborn!
			</p>

			<section class="mt-5 grid items-center gap-8 lg:mt-[27px] lg:grid-cols-[494px_489px] lg:justify-center lg:gap-4">
				<div class="text-center">
					<h1 class="font-display font-bold text-[44px] leading-[1.4] sm:text-[56px] lg:text-[67px]">
						<span class="block text-gray-1">ANY LESSON.</span>
						<span class="block text-gray-2">ANY SUNDAY.</span>
					</h1>
					<h2 class="mt-4 text-[22px] leading-[1.4] font-bold text-ink lg:text-[28px]">
						Packs of Bible Learning Activities to spark up your existing lessons.
					</h2>
					<Button href={downloadPage} color="charcoal" class="mt-5 w-full max-w-[387px]">Go to the Download Page</Button>
				</div>
				<img
					src="/images/bla-packs.webp"
					alt="BLA Pack Quick Start Guides with Bible Guy"
					width="1000"
					height="943"
					class="mx-auto h-auto w-full max-w-[489px]"
					fetchpriority="high"
				/>
			</section>

			<!-- ===== Hi, I'm Tom ===== -->
			<section class="mt-10 flex flex-col items-center gap-8 md:flex-row md:items-start md:justify-center md:gap-9">
				<img src="/images/tom.webp" alt="Tom" width="482" height="482" class="size-[220px] shrink-0 md:size-[265px]" />
				<div class="max-w-[584px] pt-2">
					<h2 class="mb-1 text-[30px] leading-[1.4] font-bold text-ink lg:text-[34px]">Hi, I’m Tom.</h2>
					<p>Welcome to <strong>Christ’s Love and Majesty Ministries,</strong>&nbsp; CLAMcentral for short.</p>
					<p>Quality Children’s Ministry resources for people like yourself, people serving God by working with kids.</p>
					<p>Everything is free of charge. I hope to keep it that way, always depending on donations to keep the lights on and the pizzas coming.</p>
				</div>
			</section>

			<p class="mx-auto mt-6 max-w-[1038px] text-center text-[20px] leading-[1.4]">
				<strong class="text-gray-1">NEW!</strong> Choose from hundreds of Bible Learning Activities in my library of BLA Packs. Curated and categorized Sunday School activities ready to add light and energy to your regular lesson plans.
			</p>

			<!-- ===== Endorsements ===== -->
			<section class="mx-auto mt-12 grid max-w-[999px] items-start gap-[15px] md:grid-cols-3">
				{
					endorsements.map((e) => (
						<figure class="rounded-[10px] bg-white/60 px-[35px] pt-9 pb-8 text-center shadow-[0_10px_28px_2px_rgba(0,0,0,0.08)]">
							<div class="flex justify-center gap-px" aria-label="5 stars">
								{[1, 2, 3, 4, 5].map(() => (
									<svg viewBox="-6 -6 70 70" class="size-4" aria-hidden="true"><path fill="#F0C419" d={star} /></svg>
								))}
							</div>
							<blockquote class="mt-4 mb-3">{e.quote}</blockquote>
							<figcaption class="leading-[1.3] tracking-[1px]">
								<strong class="block">{e.name}</strong>
								<span class="block">{e.title}</span>
							</figcaption>
						</figure>
					))
				}
			</section>

			<!-- ===== Intro video ===== -->
			<section class="relative mx-auto mt-20 max-w-[1040px] rounded-[10px] bg-cream px-6 pt-8 pb-24 shadow-[0_7px_28px_rgba(0,0,0,0.12)] md:px-[35px] md:pt-[45px] md:pb-[60px]">
				<div class="grid items-start gap-8 md:grid-cols-[536px_1fr] md:gap-[51px]">
					<a href="https://youtu.be/nbbBzwRbank" class="block transition-opacity hover:opacity-90">
						<img src="/images/intro-video.webp" alt="Watch: Cage-Free Bible Learning Activities" width="1100" height="643" loading="lazy" class="h-auto w-full" />
					</a>
					<div class="max-w-[377px] text-[20px] leading-[1.35]">
						<h3 class="mb-1 text-[22px] leading-[1.4] font-bold text-ink">Revolutionary? You decide...</h3>
						<p>If you’ve ever wished you had a way to breathe some life into a bland but otherwise OK lesson...</p>
						<p>...by this Sunday, you will have it.</p>
					</div>
				</div>
			</section>

			<!-- ===== Sampler ===== -->
			<img
				src="/images/bible-guy-sampler.webp"
				alt="Bible Guy with a fan of BLA Pack Quick Start Guides"
				width="2160"
				height="677"
				loading="lazy"
				class="relative -mt-10 h-auto w-full md:-mt-[59px]"
			/>
			<div class="mt-8 text-center">
				<Button href={downloadPage} class="w-full max-w-[540px]">Go to the Download Page</Button>
			</div>
			<p class="mt-2 text-center text-[26px] leading-[1.4] lg:text-[34px]">Your existing curriculum, reborn!</p>

			<!-- ===== Newsletter sign-up ===== -->
			<section class="mt-12 text-center">
				<p class="mx-auto max-w-[1064px]">
					<strong>Join the over 1,000 members on our mailing lists.</strong> Sign up to receive the monthly CLAMcentral Regulars Newsletter. The Newsletter will alert you to any and all updates to the BLA Packs and other key Children’s Ministry resources.
				</p>
				<!-- TODO: connect to ActiveCampaign (see README) -->
				<form id="signup" class="mt-8 grid gap-[15px] md:grid-cols-[1fr_1fr_236px]" action="#" method="post">
					<input type="text" name="name" placeholder="Name" aria-label="Name" class="h-[51px] rounded-[3px] bg-white px-4 font-button text-[14px] text-[#111]" />
					<input type="email" name="email" placeholder="Email" aria-label="Email" required class="h-[51px] rounded-[3px] bg-white px-4 font-button text-[14px] text-[#111]" />
					<button type="submit" class="h-[51px] rounded-[7px] bg-teal-form text-[24px] font-bold tracking-[1px] text-white transition-opacity hover:opacity-85" style="font-family: Roboto, Arial, sans-serif">Sign Up</button>
				</form>
			</section>

			<!-- ===== Donate ===== -->
			<section class="mt-9 text-center">
				<img src="/images/bible-guy.webp" alt="Bible Guy" width="340" height="389" loading="lazy" class="mx-auto h-[184px] w-auto" />
				<p class="mt-1 text-[16px]">Bible Guy Thinks You’re Awesome!</p>
				<Button href={donateUrl} class="mt-12 w-full max-w-[540px]">Support CLAMcentral with a Donation</Button>
			</section>
		</div>
	</main>
</Layout>
