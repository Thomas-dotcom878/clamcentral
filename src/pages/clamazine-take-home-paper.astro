---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
---

<Layout title="CLAMazine Take Home Paper - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/clamcentral-logo.webp" alt="" width="600" height="121" loading="lazy" class="mx-auto h-auto w-full" style="max-width:266px" />
			</div>
			<div style="margin-top:21px">
				<h1 style="font-size:clamp(35px, 3.64vw, 51px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700">CLAMazine Take-Home Paper</h1>
			</div>
			<div style="margin-top:2px">
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>Take your Sunday morning teaching into the home.</strong></p>
			</div>
			<div style="margin-top:21px">
				<img src="/images/pages/clamazineinserts.webp" alt="" width="1878" height="1088" loading="lazy" class="mx-auto h-auto w-full" style="max-width:1040px" />
			</div>
			<div style="margin-top:21px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center"><strong>Intended for Upper Elementary Sunday School, the weekly CLAMazine is based on every one of our Old Testament lessons.</strong> Kids that love comic cartoon stories with ongoing characters plus challenging games, all based on each Sunday's themes, will love CLAMazine.</p>
			</div>
			<div>
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.40;color:rgb(0, 0, 0);text-align:center">The CLAMazine Take-Home Papers are included in our CLAMbake Old Testament Sunday School curriculum. Check that out <a href="/clambake-old-testament">HERE.</a></p>
			</div>
		</div>
	</main>
</Layout>
