---
// Rebuilt from the live WordPress page layout.
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kids Party One-Shot - clamcentral.com">
	<main class="px-4 pt-12 pb-20" style="background: #fffdf4">
		<div class="mx-auto max-w-[1080px]">
			<div>
				<img src="/images/clamcentral-logo.webp" alt="" width="600" height="121" loading="lazy" class="mx-auto h-auto w-full" style="max-width:300px" />
			</div>
			<div style="margin-top:31px">
				<h1 style="font-size:clamp(34px, 3.57vw, 50px);line-height:1.30;color:rgb(12, 17, 21);text-align:center;font-weight:700">Kids Party One-Shot</h1>
			</div>
			<div style="margin-top:2px">
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.60;color:rgb(0, 0, 0);text-align:center"><strong>A fun games and Bible story midweek event.</strong></p>
			</div>
			<div style="margin-top:21px">
				<img src="/images/pages/kp-oneshot.webp" alt="" width="2080" height="969" loading="lazy" class="mx-auto h-auto w-full" style="max-width:1040px" />
			</div>
			<div style="margin-top:20px">
				<p style="font-size:clamp(18px, 1.57vw, 22px);line-height:1.60;color:rgb(0, 0, 0);text-align:center">For years I ran a program on Friday nights I called Kids Party. Designed to bring in new kids and their families, it was very successful! Fun games and always a Bible story. The <a href="/kids-party-events-program/">full program</a> lasts three years before being repeated, so yeah, it's big. BUT if you wish to start small, here is Kids Party One-Shot: a planned single event the kids will love.</p>
			</div>
			<div style="margin-top:5px">
				<p style="font-size:clamp(22px, 2.29vw, 32px);line-height:1.40;color:rgb(0, 0, 0);text-align:center"><strong><a href="/oneshot/kids-party-one-shot.pdf"><strong>Click Here to Download</strong></a></strong></p>
			</div>
		</div>
	</main>
</Layout>
