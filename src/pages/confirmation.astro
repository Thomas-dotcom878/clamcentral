---
// Thank-you page people land on after signing up for the newsletter.
// In ActiveCampaign, the "Website Newsletter" form redirects here (On Submit → Redirect to URL).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Confirmation - clamcentral.com">
	<main class="px-4 pt-12 pb-20">
		<div class="mx-auto max-w-[965px] text-center" style="color:rgb(70, 70, 70)">
			<h1 style="font-size:clamp(34px, 3.57vw, 50px);line-height:1.30;color:rgb(51, 51, 51);text-align:center"><strong>You Have Signed Up!</strong></h1>
			<img src="/wp-content/uploads/2019/12/emailletter20.png" alt="" width="301" class="mx-auto mt-10 mb-12 h-auto w-full" style="max-width:301px" />
			<p style="font-size:22px;line-height:1.40"><strong>Thanks so much! Check your email.</strong></p>
			<p style="font-size:18px;line-height:1.40">We are excited that you have joined us at CLAMcentral. Remember, the CLAM in CLAMcentral stands for <strong>Christ's Love and Majesty.</strong> Our goal is to help you disciple kids, helping them celebrate the love and majesty of our Lord. His love is all He says and does, and His majesty is Who He is, the Son of God!</p>
			<p style="font-size:18px;line-height:1.40">Again, thanks! Our prayer is that your ministry plays a major role in bringing kids to our Lord Jesus Christ!</p>
		</div>
	</main>
</Layout>
